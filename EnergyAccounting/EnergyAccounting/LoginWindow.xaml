<Window x:Class="EnergyAccounting.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - Учет энергоресурсов" Height="623" Width="458"
        WindowStartupLocation="CenterScreen" Background="#F8F6FC"
        ResizeMode="NoResize">

    <Window.Resources>
        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#9C27B0" Offset="0.0"/>
            <GradientStop Color="#BA68C8" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Margin="0,0,0,-6">
        <Border Background="White" CornerRadius="15" Margin="30" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#9C27B0" BlurRadius="25" ShadowDepth="5" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="⚡" FontSize="40" Foreground="#9C27B0" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold" Foreground="#4A148C" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Поле Логин -->
                <TextBlock Text="Логин" FontSize="14" Foreground="#7B1FA2" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtLogin" Padding="10,8" FontSize="14" BorderBrush="#E1BEE7" BorderThickness="1.5" Margin="0,0,0,15"/>

                <!-- Поле Пароль -->
                <TextBlock Text="Пароль" FontSize="14" Foreground="#7B1FA2" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtPassword" Padding="10,8" FontSize="14" BorderBrush="#E1BEE7" BorderThickness="1.5" Margin="0,0,0,15"/>

                <!-- Блок капчи (скрыт по умолчанию) -->
                <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed">
                    <TextBlock Text="Введите код с картинки (защита от взлома):" FontSize="14" Foreground="#E53935" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Место для отрисовки картинки -->
                        <Border Grid.Column="0" Background="#F3E5F5" CornerRadius="5" Padding="5" Margin="0,0,10,0">
                            <Canvas x:Name="CaptchaCanvas" Width="100" Height="40"/>
                        </Border>

                        <!-- Поле ввода капчи -->
                        <TextBox x:Name="TxtCaptcha" Grid.Column="1" Padding="10,8" FontSize="14" BorderBrush="#E1BEE7" BorderThickness="1.5"/>
                    </Grid>
                </StackPanel>

                <!-- Кнопка Войти -->
                <Button x:Name="BtnLogin" Content="Войти" Click="BtnLogin_Click"
                        Height="45" FontSize="16" FontWeight="SemiBold" Foreground="White" 
                        Background="{StaticResource ButtonGradient}" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Сообщение об ошибке -->
                <TextBlock x:Name="TxtError" Foreground="Red" FontSize="13" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>