<Window x:Class="EnergyAccounting.ReadingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод показаний" Height="750" Width="1150"
        WindowStartupLocation="CenterScreen" Background="#F8F6FC">

    <Window.Resources>
        <!-- Стили (градиенты и кнопки) как в вашем утвержденном макете -->
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7B1FA2" Offset="0.0"/>
            <GradientStop Color="#E1BEE7" Offset="1.0"/>
        </LinearGradientBrush>
        <!-- ... (скопируйте остальные стили из утвержденного макета) ... -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{StaticResource PurpleGradient}">
            <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="⚡ Ввод показаний" FontSize="20" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Контент -->
        <Grid Grid.Row="1" Margin="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель (Список квартир) -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="0,0,25,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Выбор квартиры" FontSize="18" FontWeight="Bold" Foreground="#4A148C" Margin="0,0,0,15"/>
                    <ListBox x:Name="ListApartments" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="ListApartments_SelectionChanged" DisplayMemberPath="DisplayInfo"/>
                </Grid>
            </Border>

            <!-- Правая панель (Таблица показаний) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Инфо о квартире -->
                <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="TxtApartmentInfo" Text="Выберите квартиру" FontSize="24" FontWeight="Bold" Foreground="#4A148C"/>
                        <TextBlock x:Name="TxtOwnerInfo" FontSize="15" Foreground="#6A1B9A" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Таблица -->
                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="25">
                    <DataGrid x:Name="GridReadings" AutoGenerateColumns="False" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="#FCFAFF"
                              BorderThickness="0" GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="#E1BEE7" CanUserAddRows="False"
                              ColumnHeaderHeight="45" RowHeight="50">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ресурс" Binding="{Binding ResourceName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Предыдущее" Binding="{Binding PreviousValue}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Текущее" Binding="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Расход" Binding="{Binding Consumption}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                    <Button Content="Назад" Click="BtnBack_Click" Margin="0,0,15,0" Padding="25,12" MinWidth="100"/>
                    <Button Content="Сохранить и рассчитать" Click="BtnSave_Click" Background="#9C27B0" Foreground="White" Padding="30,12" MinWidth="200"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>