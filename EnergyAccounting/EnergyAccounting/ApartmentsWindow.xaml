<Window x:Class="EnergyAccounting.ApartmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справочник квартир" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F8F6FC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7B1FA2">
            <TextBlock Text="Справочник квартир" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="30,0,0,0"/>
        </Border>

        <Border Grid.Row="1" Background="White" Margin="20" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="GridApartments" AutoGenerateColumns="True" IsReadOnly="True" 
                          Background="Transparent" BorderThickness="0" RowHeight="40"/>

                <Button Grid.Row="1" Content="Обновить" Click="BtnRefresh_Click" 
                        HorizontalAlignment="Right" Margin="0,15,0,0" Padding="20,10" 
                        Background="#9C27B0" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>