<Window x:Class="EnergyAccounting.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчеты" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#F8F6FC">

    <Window.Resources>
        <!-- Градиент для шапки -->
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7B1FA2" Offset="0.0"/>
            <GradientStop Color="#E1BEE7" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Стиль для кнопки "Обновить" -->
        <Style x:Key="UpdateButton" TargetType="Button">
            <Setter Property="Background" Value="#9C27B0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7B1FA2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки "Экспорт в Excel" -->
        <Style x:Key="ExcelButton" TargetType="Button">
            <Setter Property="Background" Value="#1D6F42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#154F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна -->
        <Border Grid.Row="0" Background="{StaticResource PurpleGradient}">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="📈 Отчеты" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <Button Content="Закрыть" Click="BtnClose_Click" HorizontalAlignment="Right" Margin="0,0,30,0" 
                        Background="White" Foreground="#7B1FA2" Padding="15,8" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Панель фильтров и кнопок -->
            <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="#9C27B0" BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Фильтры -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="#4A148C"/>
                        <ComboBox x:Name="CmbPeriod" Width="150" Padding="5" SelectedIndex="0" SelectionChanged="CmbPeriod_SelectionChanged">
                            <ComboBoxItem Content="Текущий месяц"/>
                            <ComboBoxItem Content="Прошлый месяц"/>
                            <ComboBoxItem Content="За всё время"/>
                        </ComboBox>
                        <Button Content="Обновить" Click="BtnRefresh_Click" Margin="20,0,0,0" Style="{StaticResource UpdateButton}"/>
                    </StackPanel>

                    <!-- Кнопка экспорта -->
                    <Button Grid.Column="2" Content="📥 Экспорт в Excel" Style="{StaticResource ExcelButton}" 
                            Click="BtnExportExcel_Click"/>
                </Grid>
            </Border>

            <!-- Таблица результатов -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#9C27B0" BlurRadius="20" ShadowDepth="5" Opacity="0.1"/>
                </Border.Effect>
                <DataGrid x:Name="GridReports" AutoGenerateColumns="True" IsReadOnly="True" 
                          Background="Transparent" BorderThickness="0" RowHeight="45"
                          RowBackground="Transparent" AlternatingRowBackground="#FCFAFF"
                          ColumnHeaderHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1BEE7"
                          CanUserAddRows="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#7B1FA2"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="BorderBrush" Value="#E1BEE7"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>