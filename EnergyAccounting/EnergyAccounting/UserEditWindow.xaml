<Window x:Class="EnergyAccounting.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль пользователя" Height="550" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F8F6FC">

    <Window.Resources>
        <!-- Градиент для кнопок -->
        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#9C27B0" Offset="0.0"/>
            <GradientStop Color="#BA68C8" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="GradientButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource ButtonGradient}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7B1FA2">
            <TextBlock x:Name="TxtTitle" Text="Редактирование профиля" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="30,0,0,0"/>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="30" VerticalAlignment="Top">
                <!-- Аватарка -->
                <Border Width="120" Height="120" CornerRadius="60" ClipToBounds="True" HorizontalAlignment="Center" Background="#E1BEE7" Margin="0,0,0,10">
                    <Image x:Name="ImgAvatar" Stretch="UniformToFill"/>
                </Border>

                <Button Content="Загрузить фото" Click="BtnUploadAvatar_Click" Style="{StaticResource GradientButton}" Margin="0,0,0,20" HorizontalAlignment="Center" Width="150" Height="21"/>

                <TextBlock Text="ФИО:" Foreground="#4A148C" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtFullName" Margin="0,5,0,10" Padding="8" BorderBrush="#E1BEE7"/>

                <TextBlock Text="Логин:" Foreground="#4A148C" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtLogin" Margin="0,5,0,10" Padding="8" BorderBrush="#E1BEE7"/>

                <TextBlock Text="Пароль:" Foreground="#4A148C" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtPassword" Margin="0,5,0,10" Padding="8" BorderBrush="#E1BEE7"/>

                <TextBlock Text="Роль:" Foreground="#4A148C" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbRole" Margin="0,5,0,25" Padding="8" BorderBrush="#E1BEE7">
                    <ComboBoxItem Content="Admin"/>
                    <ComboBoxItem Content="Operator"/>
                    <ComboBoxItem Content="Owner"/>
                </ComboBox>

                <Button Content="Сохранить" Click="BtnSave_Click" Style="{StaticResource GradientButton}" FontSize="16" Height="45"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>