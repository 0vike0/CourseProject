<Window x:Class="EnergyAccounting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет энергоресурсов" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F8F6FC">

    <Window.Resources>
        <!-- Градиент для шапки -->
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7B1FA2" Offset="0.0"/>
            <GradientStop Color="#E1BEE7" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Стиль для кнопок меню -->
        <Style TargetType="Button" x:Key="MenuButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#4A148C"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#9C27B0" BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3E5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{StaticResource PurpleGradient}">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Учет энергоресурсов" FontSize="24" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,30,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtUserInfo" Foreground="White" FontSize="14" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <Button Content="Выйти" Click="BtnLogout_Click" Background="White" Foreground="#7B1FA2" Padding="15,8" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левое меню -->
            <StackPanel Grid.Column="0" Margin="0,0,30,0">
                <TextBlock Text="Меню" FontSize="20" FontWeight="Bold" Foreground="#4A148C" Margin="0,0,0,25"/>

                <Button x:Name="BtnProfile" Content="Мой профиль" Style="{StaticResource MenuButton}" Click="BtnProfile_Click"/>
                <Button x:Name="BtnReadings" Content="Ввод показаний" Style="{StaticResource MenuButton}" Click="BtnReadings_Click"/>
                <Button x:Name="BtnApartments" Content="Справочник квартир" Style="{StaticResource MenuButton}" Click="BtnApartments_Click"/>
                <Button x:Name="BtnReports" Content="Отчеты" Style="{StaticResource MenuButton}" Click="BtnReports_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnTariffs" Content="Управление тарифами" Style="{StaticResource MenuButton}" Click="BtnTariffs_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnUsers" Content="Пользователи" Style="{StaticResource MenuButton}" Click="BtnUsers_Click" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Правая часть (Дашборд) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtDashboardTitle" Text="Сводка" FontSize="22" FontWeight="Bold" Foreground="#4A148C" Margin="0,0,0,20"/>

                <!-- Карточки со статистикой (заполняются в коде) -->
                <WrapPanel x:Name="DashboardPanel" Grid.Row="1">
                    <!-- Карточка 1 -->
                    <Border Background="White" CornerRadius="12" Padding="25" Width="240" Height="120" Margin="0,0,20,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#9C27B0" BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtCard1Title" Text="Квартир в системе" FontSize="14" Foreground="#7B1FA2" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtCard1Value" Text="0" FontSize="32" FontWeight="Bold" Foreground="#4A148C"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка 2 -->
                    <Border Background="White" CornerRadius="12" Padding="25" Width="240" Height="120" Margin="0,0,20,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#9C27B0" BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtCard2Title" Text="Всего собственников" FontSize="14" Foreground="#7B1FA2" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtCard2Value" Text="0" FontSize="32" FontWeight="Bold" Foreground="#4A148C"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка 3 -->
                    <Border Background="White" CornerRadius="12" Padding="25" Width="240" Height="120" Margin="0,0,20,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#9C27B0" BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtCard3Title" Text="Показаний за месяц" FontSize="14" Foreground="#7B1FA2" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtCard3Value" Text="0" FontSize="32" FontWeight="Bold" Foreground="#4A148C"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>