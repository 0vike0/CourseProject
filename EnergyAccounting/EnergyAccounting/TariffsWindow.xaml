<Window x:Class="EnergyAccounting.TariffsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление тарифами" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F8F6FC">

    <Window.Resources>
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7B1FA2" Offset="0.0"/>
            <GradientStop Color="#E1BEE7" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#9C27B0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7B1FA2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{StaticResource PurpleGradient}">
            <Grid>
                <TextBlock Text="⚙️ Управление тарифами" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="30,0,0,0"/>
                <Button Content="Закрыть" Click="BtnClose_Click" HorizontalAlignment="Right" Margin="0,0,30,0" 
                        Background="White" Foreground="#7B1FA2" Padding="15,8" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Контент -->
        <Grid Grid.Row="1" Margin="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Таблица тарифов -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,20,0">
                <DataGrid x:Name="GridTariffs" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="Transparent" BorderThickness="0" RowHeight="40"
                          RowBackground="Transparent" AlternatingRowBackground="#FCFAFF"
                          ColumnHeaderHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1BEE7">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ресурс" Binding="{Binding ResourceName}" Width="*"/>
                        <DataGridTextColumn Header="Цена (руб)" Binding="{Binding Price}" Width="*"/>
                        <DataGridTextColumn Header="Дата введения" Binding="{Binding EffectiveDate}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Форма добавления -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Добавить новый тариф" FontSize="16" FontWeight="Bold" Foreground="#4A148C" Margin="0,0,0,20"/>

                    <TextBlock Text="Ресурс:" Foreground="#7B1FA2" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbResource" Margin="0,0,0,15" Padding="5" Height="30" DisplayMemberPath="Name" SelectedValuePath="id"/>

                    <TextBlock Text="Цена (руб):" Foreground="#7B1FA2" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtPrice" Margin="0,0,0,15" Padding="5" Height="30"/>

                    <TextBlock Text="Дата введения:" Foreground="#7B1FA2" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DpDate" Margin="0,0,0,25" Height="30"/>

                    <Button Content="Добавить тариф" Click="BtnAdd_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>